{
  "name": "jokerdeck-switch",
  "version": "0.3.13",
  "description": "Jokerdeck desktop launcher for Codex and compatible local tools",
  "main": "src/main.js",
  "author": "jokerdeck",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test test/*.test.js",
    "core:mac": "node scripts/fetch-proxy-core.mjs mac-arm64 mac-x64",
    "core:win": "node scripts/fetch-proxy-core.mjs win-x64",
    "localization:mac": "bash scripts/build-localization-mac.sh",
    "predist:mac": "npm run core:mac",
    "predist:win": "npm run core:win",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "site:manifest": "node scripts/site-manifest.mjs"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "net.de5.jokerdeck.switch",
    "productName": "Jokerdeck Switch",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "vendor/LICENSE-*",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "signIgnore": [
        "/Contents/Resources/helpers/"
      ],
      "extraResources": [
        {
          "from": "vendor/mac",
          "to": "helpers"
        },
        {
          "from": "vendor/core/mac",
          "to": "core",
          "filter": ["**/mihomo"]
        }
      ],
      "artifactName": "jokerdeck-switch-${version}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "extraResources": [
        {
          "from": "vendor/win",
          "to": "helpers"
        },
        {
          "from": "vendor/core/win",
          "to": "core",
          "filter": ["**/mihomo.exe"]
        }
      ],
      "target": [
        "nsis"
      ],
      "artifactName": "jokerdeck-switch-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": 2052
    }
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
